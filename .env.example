# Copy to .env.local and fill in your values — NEVER commit real credentials.
# All values below are placeholders.

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret to protect /api/refresh — generate with: openssl rand -hex 32
# Vercel Cron sends this automatically as Bearer token when set in project env vars
CRON_SECRET=<generate-with-openssl-rand-hex-32>

# VAPID keys for Web Push notifications — generate with: npx web-push generate-vapid-keys
# The PUBLIC key must also be set as VAPID_PUBLIC_KEY constant in public/app.jsx
VAPID_PUBLIC_KEY=<your-vapid-public-key>
VAPID_PRIVATE_KEY=<your-vapid-private-key>
