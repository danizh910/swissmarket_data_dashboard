# Copy to .env.local and fill in your values — never commit real credentials

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret to protect /api/refresh — generate with: openssl rand -hex 32
# Vercel Cron sends this automatically as Bearer token
CRON_SECRET=Password123.

# VAPID keys for Web Push notifications
